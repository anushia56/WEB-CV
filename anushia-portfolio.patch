+﻿:root {
+  --space: #0a0a0f;
+  --charcoal: #141418;
+  --white: #f0eee8;
+  --muted: #9f9d98;
+  --amber: #ff9fbe;
+  --teal: #ff6b9d;
+  --line: rgba(240, 238, 232, 0.14);
+  --glass: rgba(20, 20, 24, 0.68);
+  --shadow: 0 24px 80px rgba(0, 0, 0, 0.38);
+  --heading: "Space Grotesk", "Inter", "Arial", sans-serif;
+  --mono: "DM Mono", "SFMono-Regular", Consolas, monospace;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html {
+  scroll-behavior: smooth;
+  background: var(--space);
+}
+
+body {
+  margin: 0;
+  color: var(--white);
+  background:
+    radial-gradient(circle at 82% 18%, rgba(255, 107, 157, 0.12), transparent 28rem),
+    radial-gradient(circle at 8% 8%, rgba(255, 159, 190, 0.08), transparent 24rem),
+    var(--space);
+  font-family: var(--heading);
+  overflow-x: hidden;
+  cursor: none;
+}
+
+a,
+button {
+  color: inherit;
+  cursor: none;
+}
+
+.cursor {
+  position: fixed;
+  z-index: 10000;
+  width: 9px;
+  height: 9px;
+  pointer-events: none;
+  transform: translate(-50%, -50%);
+  transition: transform 180ms ease;
+}
+
+.cursor span {
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  background: var(--white);
+  box-shadow: 0 0 10px rgba(255, 107, 157, 0.78), 0 0 18px rgba(240, 238, 232, 0.36);
+}
+
+.cursor span::after {
+  position: absolute;
+  left: -9px;
+  top: 4px;
+  width: 15px;
+  height: 1px;
+  background: linear-gradient(90deg, transparent, rgba(255, 107, 157, 0.7));
+  content: "";
+  transform: rotate(-28deg);
+}
+
+.cursor.is-hovering {
+  transform: translate(-50%, -50%) scale(1.35);
+}
+
+.cursor-trail span {
+  position: fixed;
+  z-index: 9999;
+  width: 4px;
+  height: 4px;
+  border-radius: 50%;
+  background: rgba(255, 107, 157, 0.55);
+  box-shadow: 0 0 12px rgba(255, 107, 157, 0.28);
+  opacity: 0;
+  pointer-events: none;
+  transform: translate(-50%, -50%);
+  transition: opacity 160ms ease;
+}
+
+.loader {
+  position: fixed;
+  inset: 0;
+  z-index: 9999;
+  display: grid;
+  place-items: center;
+  align-content: center;
+  gap: 22px;
+  background: var(--space);
+  transition: opacity 700ms ease, visibility 700ms ease;
+}
+
+.loader.is-hidden {
+  opacity: 0;
+  visibility: hidden;
+}
+
+.teacup {
+  width: 150px;
+  animation: cup-rise 900ms ease 2s forwards;
+}
+
+.teacup svg {
+  width: 100%;
+  overflow: visible;
+  fill: none;
+}
+
+.cup,
+.saucer {
+  fill: none;
+  stroke: var(--teal);
+  stroke-width: 3;
+}
+
+.rim,
+.handle {
+  stroke: var(--teal);
+  stroke-width: 4;
+  stroke-linecap: round;
+}
+
+.steam {
+  stroke: var(--teal);
+  stroke-width: 4;
+  stroke-linecap: round;
+  animation: steam 2s ease-in-out infinite;
+}
+
+.steam-two {
+  animation-delay: 260ms;
+}
+
+.steam-three {
+  animation-delay: 520ms;
+}
+
+.orbital-loader {
+  width: 68px;
+  height: 68px;
+  border: 1px solid rgba(240, 238, 232, 0.12);
+  border-radius: 50%;
+  position: relative;
+}
+
+.orbital-loader span {
+  position: absolute;
+  inset: -1px;
+  border-radius: 50%;
+  border: 2px solid transparent;
+  border-top-color: var(--teal);
+  animation: spin 1.1s linear infinite;
+}
+
+.loader p,
+.eyebrow,
+.hero-meta,
+.hero-actions,
+.skill-chips,
+.timeline-card p,
+.timeline-card time,
+.transmission-links,
+.availability-strip,
+.site-footer {
+  font-family: var(--mono);
+}
+
+.loader p {
+  color: var(--muted);
+  font-size: 0.78rem;
+}
+
+.site-header {
+  position: fixed;
+  top: 22px;
+  left: 28px;
+  right: 28px;
+  z-index: 100;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 14px 18px;
+  border: 1px solid transparent;
+  transition: background 200ms ease, border-color 200ms ease, backdrop-filter 200ms ease;
+}
+
+.site-header.is-scrolled {
+  background: rgba(10, 10, 15, 0.66);
+  border-color: var(--line);
+  backdrop-filter: blur(16px);
+}
+
+.brand-mark {
+  display: grid;
+  width: 46px;
+  height: 46px;
+  place-items: center;
+  text-decoration: none;
+  overflow: hidden;
+}
+
+.brand-mark img {
+  display: block;
+  width: 76%;
+  height: 76%;
+  object-fit: contain;
+}
+
+.main-nav {
+  display: flex;
+  justify-content: flex-end;
+  gap: 12px;
+  font-size: 0.76rem;
+  font-weight: 700;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+}
+
+.main-nav a {
+  position: relative;
+  text-decoration: none;
+  color: rgba(240, 238, 232, 0.76);
+}
+
+.main-nav a:not(:last-child)::after {
+  content: "/";
+  margin-left: 12px;
+  color: rgba(240, 238, 232, 0.28);
+}
+
+.main-nav a::before {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 18px;
+  bottom: -8px;
+  height: 1px;
+  transform: scaleX(0);
+  transform-origin: left;
+  background: var(--teal);
+  transition: transform 180ms ease;
+}
+
+.main-nav a.active,
+.main-nav a:hover {
+  color: var(--white);
+}
+
+.main-nav a.active::before,
+.main-nav a:hover::before {
+  transform: scaleX(1);
+}
+
+.section {
+  position: relative;
+  min-height: 100vh;
+  padding: 118px 0;
